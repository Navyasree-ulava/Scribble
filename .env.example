# Environment variables for the Railway backend services.
# Copy the relevant block into each service's Variables tab on Railway.
# Do NOT commit real secrets — this file is a template only.

# ---- Required by BOTH http-backend and ws-backend ----

# Signing secret for auth tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The http-backend signs with it and the ws-backend verifies with it, so both
# services MUST have the identical value or WebSocket auth will fail.
JWT_SECRET=

# Neon Postgres connection string (from your Neon dashboard).
# Note: local .env files are gitignored, so this must be set on Railway.
DATABASE_URL=

# ---- http-backend only ----

# Comma-separated list of allowed browser origins.
# Set this to your Vercel URL after the frontend is deployed, e.g.
#   CORS_ORIGIN=https://scribble.vercel.app,https://scribble-git-main-yourname.vercel.app
# Leave empty to allow any origin (fine for local dev, not for production).
CORS_ORIGIN=

# ---- ws-backend only ----
# No extra variables. PORT is injected automatically by Railway.
